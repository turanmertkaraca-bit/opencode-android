<?xml version="1.0" encoding="utf-8"?>
<!-- P12 monochrome empty-state hero: graphite disc + white glyph, ring. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="70dp"
                android:centerX="0.5" android:centerY="0.4"
                android:startColor="#2E2E2E" android:endColor="#161616"/>
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#00000000"/>
            <stroke android:width="1dp" android:color="#3D3D3D"/>
        </shape>
    </item>
</layer-list>
