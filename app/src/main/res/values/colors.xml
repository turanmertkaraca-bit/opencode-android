<?xml version="1.0" encoding="utf-8"?>
<!-- P12 "graphite" palette — MONOCHROME by user request ("make the app
     more monochrome"). Pure grayscale ladder + white ink accent; the only
     hue left in the whole app is the desaturated error red (functional,
     not decorative). Same color NAMES as P4-P11 (every screen keeps
     working), values re-tuned for the new visual language. -->
<resources>
    <color name="bg">#0A0A0A</color>
    <color name="surface">#151515</color>
    <color name="surface2">#1D1D1D</color>
    <color name="stroke">#2A2A2A</color>
    <color name="accent">#E8E8E8</color>
    <color name="accent_light">#FFFFFF</color>
    <color name="on_accent">#111111</color>
    <color name="text_primary">#F2F2F2</color>
    <color name="text_secondary">#8F8F8F</color>
    <color name="user_bubble">#262626</color>
    <color name="user_text">#F2F2F2</color>
    <color name="ok">#D9D9D9</color>
    <color name="err">#E07A7A</color>
    <color name="warn">#A6A6A6</color>
    <color name="ic_bg">#E8E8E8</color>
    <!-- P8 extras (kept for compatibility) -->
    <color name="bg_glow">#161616</color>
    <color name="dot_ready">#E8E8E8</color>
