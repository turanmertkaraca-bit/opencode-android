<?xml version="1.0" encoding="utf-8"?>
<!-- P9 chat screen — modern messenger feel:
     header with brand glyph · transcript (gradient user bubbles, markdown
     assistant blocks, collapsible tool/thought cards, hero empty state) ·
     raised composer bar (⌘ + Build/Plan + model chips, pill input, FAB). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <!-- P42: 40dp + minWidth — the 36dp chip was both sub-a11y and
             visually crushed when the weighted title shrank on narrow
             screens; the fixed floor keeps the back affordance stable. -->
        <TextView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:minWidth="40dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_chip"
            android:contentDescription="Back"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/accent_light"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="New chat"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="connecting…"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>

        <!-- P14: session spend — its OWN pill so ⇅ tokens and $ cost are
             never ellipsized away by the one-line subtitle again.
             P42: maxWidth + middle ellipsize — a long meter line can no
             longer squeeze the weighted title to zero (the "back button
             squish" field report); wider tap padding (7dp) makes the
             Σ popover discoverable. -->
        <TextView
            android:id="@+id/tvSpend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chip"
            android:contentDescription="Context and spend meter"
            android:maxWidth="120dp"
            android:ellipsize="middle"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:fontFamily="monospace"
            android:text="⇅ 0 · $0"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:maxLines="1"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/btnSessions"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chip"
            android:contentDescription="Sessions"
            android:gravity="center"
            android:text="≡"
            android:textColor="@color/accent_light"
            android:textSize="20sp"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/stroke"/>

    <!-- transcript. P27: wrapped in a FrameLayout so the "↓ latest"
         scroll pill lives INSIDE the transcript's bounds — the old decor-
         anchored pill (fixed 96dp bottom margin) floated ON TOP of the
         composer text whenever the input grew past one line (field shot:
         the pill covering the user's own typed words). -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/emptyHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="46dp"
                android:paddingStart="28dp"
                android:paddingEnd="28dp">

                <TextView
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:background="@drawable/bg_hero"
                    android:gravity="center"
                    android:text="◆"
                    android:textColor="@color/on_accent"
                    android:textSize="34sp"/>

                <TextView
                    android:id="@+id/heroTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="18dp"
                    android:text="Good evening"
                    android:textColor="@color/text_primary"
                    android:textSize="21sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/heroSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="6dp"
                    android:text="How can I help you today?"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:lineSpacingExtra="2dp"/>

                <LinearLayout
                    android:id="@+id/suggestBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="20dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"/>
        </LinearLayout>
    </ScrollView>

    <!-- ↓ latest — anchored to the transcript bottom, INSIDE the frame:
         it can never overlap the composer, permission card or live footer. -->
    <TextView
        android:id="@+id/scrollPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_chip"
        android:contentDescription="Scroll to latest"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:text="↓  latest"
        android:textColor="@color/accent_light"
        android:textSize="12sp"
        android:visibility="gone"/>
    </FrameLayout>

    <!-- P26: the live edit tree — PINNED above the composer while a run
         is active (always visible, never buried by the streaming rows,
         never fights the transcript scroll). Filled by ChatActivity's
         syncLiveFooter(); gone the moment the run settles. -->
    <LinearLayout
        android:id="@+id/liveSlot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="2dp"
        android:visibility="gone"/>

    <!-- permission card slot — pinned above the composer (filled by
         checkPermissionQueue(); gone when no permission is pending). -->
    <LinearLayout
        android:id="@+id/permSlot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="2dp"
        android:textColor="@color/warn"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone"/>

    <!-- P28: the three-dot typing indicator — a DECLARED slot in the root
         column, directly above the composer. A declared slot can never
         drift into the transcript again. -->
    <LinearLayout
        android:id="@+id/typingSlot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="16dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:visibility="gone"/>

    <!-- composer. P45: the Claude-Android shape — ONE unified pill
         (composerCard, backgrounded at runtime from the live palette
         tokens via Theme.composerWell) that holds the tray, the
         borderless input, and a bottom control row: attach + palette on
         the left, Build/Plan + model chips and the send circle on the
         right. The old two-box layout (chip strip ABOVE a separate
         input well) is gone. -->
    <LinearLayout
        android:id="@+id/composerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp">

        <!-- P29: the cost-prediction hint — a quiet mono line that prices
             the NEXT send (typed text + tray images + the context the
             model re-reads) before the user commits to it. Filled by
             syncCostHint(); gone when there is nothing to send.
             P30: LEFT-aligned and ellipsize=end as the last-resort clamp. -->
        <TextView
            android:id="@+id/costHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:textColor="@color/text_tertiary"
            android:textSize="10sp"
            android:maxLines="1"
            android:visibility="gone"/>

        <!-- the pill itself — background set in onCreate from live tokens -->
        <LinearLayout
            android:id="@+id/composerCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- P29: pending image attachments — the messenger-style tray.
                 One 64dp thumb per picked photo, an ✕ badge on each, gone
                 when empty. Filled by renderAttachTray(); the send button
                 ships every tray image in ONE message. -->
            <HorizontalScrollView
                android:id="@+id/attachScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/attachSlot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="2dp"/>
            </HorizontalScrollView>

            <EditText
                android:id="@+id/input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="13dp"
                android:paddingBottom="4dp"
                android:hint="Ask the agent…"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textSize="15sp"
                android:maxLines="6"
                android:inputType="textCapSentences|textMultiLine"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="8dp">

                <!-- P17: vision — share a screenshot with the agent -->
                <TextView
                    android:id="@+id/btnVision"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_chip"
                    android:contentDescription="Attach image"
                    android:gravity="center"
                    android:text="◉"
                    android:textColor="@color/accent_light"
                    android:textSize="15sp"/>

                <TextView
                    android:id="@+id/btnPalette"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_chip"
                    android:contentDescription="Command palette"
                    android:gravity="center"
                    android:text="⌘"
                    android:textColor="@color/accent_light"
                    android:textSize="16sp"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/chipMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="11dp"
                    android:paddingEnd="11dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Build"
                    android:textColor="@color/ok"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/chipModel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="11dp"
                    android:paddingEnd="11dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="model ▾"
                    android:textColor="@color/accent_light"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="middle"
                    android:maxWidth="140dp"/>

                <TextView
                    android:id="@+id/btnSend"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_send"
                    android:contentDescription="Send"
                    android:gravity="center"
                    android:text="↑"
                    android:textColor="@color/on_accent"
                    android:textSize="20sp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
