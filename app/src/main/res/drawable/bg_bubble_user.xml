<?xml version="1.0" encoding="utf-8"?>
<!-- P27: user bubble — accent-subtle fill + hairline accent rim, flat
     (the P9 indigo→violet gradient was the loudest element on the screen;
     one accent family means subtle here). Asymmetric tail kept. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/user_bubble"/>
    <corners android:topLeftRadius="20dp" android:topRightRadius="20dp"
             android:bottomLeftRadius="20dp" android:bottomRightRadius="6dp"/>
    <stroke android:width="1dp" android:color="#2A3552"/>
</shape>
