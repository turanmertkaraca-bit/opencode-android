<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OpenCode"
            android:textColor="@color/text_primary"
            android:textSize="30sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="mobile · P6 · 0.6.0 — complete build"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tvStep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Step 1/3 — unpacking the agent…"
            android:textColor="@color/accent_light"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <!-- status card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvServerState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="○ idle"
                android:textColor="@color/accent_light"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvBinaryInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="no binary imported"
                android:textColor="@color/text_primary"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tvEndpoint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="GET http://127.0.0.1:4096/project · SSE /event"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnServer"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_btn_primary"
            android:text="Start server"
            android:textAllCaps="false"
            android:textColor="@color/on_accent"
            android:textSize="15sp"
            android:enabled="false"/>

        <Button
            android:id="@+id/btnChat"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn_primary"
            android:text="Open chat"
            android:textAllCaps="false"
            android:textColor="@color/on_accent"
            android:textSize="15sp"
            android:enabled="false"/>

        <Button
            android:id="@+id/btnSessions"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn_secondary"
            android:text="Sessions"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="15sp"/>

        <!-- connect card (P6: in-app API keys) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:layout_marginTop="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="APIs"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvAuthStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="no API keys yet"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"/>

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_btn_primary"
                android:text="Connect API keys — required"
                android:textAllCaps="false"
                android:textColor="@color/on_accent"
                android:textSize="15sp"/>
        </LinearLayout>

        <!-- setup card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:layout_marginTop="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Setup"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btnImportBin"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_btn_secondary"
                android:text="Import opencode binary"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="14sp"/>

            <Button
                android:id="@+id/btnImportAuth"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_btn_secondary"
                android:text="Import auth.json (credentials)"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="14sp"/>

            <Button
                android:id="@+id/btnImportCfg"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_btn_secondary"
                android:text="Import opencode.json (config)"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="14sp"/>
        </LinearLayout>

        <!-- sandbox card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:layout_marginTop="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Agent sandbox"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvSandbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="not installed"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"/>

            <Button
                android:id="@+id/btnSandboxInstall"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_btn_secondary"
                android:text="Install sandbox (~6 MB)"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="14sp"/>

            <Button
                android:id="@+id/btnSandboxTools"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_btn_secondary"
                android:text="Add tools: bash git nodejs python3"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="14sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"/>
    </LinearLayout>
</ScrollView>
