<?xml version="1.0" encoding="utf-8"?>
<!-- P27: THE sheet surface — near-black + 1dp hairline, rounded top
     corners (slide-up presentation), same class as the composer bar. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/surface"/>
    <corners android:topLeftRadius="22dp" android:topRightRadius="22dp"
             android:bottomLeftRadius="6dp" android:bottomRightRadius="6dp"/>
    <stroke android:width="1dp" android:color="@color/stroke"/>
</shape>
