<?xml version="1.0" encoding="utf-8"?>
<!-- P9: empty-state hero glyph — radial glow disc. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="110dp"
                android:startColor="#5B6CFF" android:endColor="#8B5CF6"/>
        </shape>
    </item>
    <item android:top="3dp" android:bottom="3dp" android:left="3dp" android:right="3dp">
        <shape android:shape="oval">
            <solid android:color="#00000000"/>
            <stroke android:width="1dp" android:color="#55FFFFFF"/>
        </shape>
    </item>
</layer-list>
